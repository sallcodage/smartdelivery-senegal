# Copier ce fichier en .env puis remplacer les valeurs. Ne jamais versionner .env.
NODE_ENV=development
PORT=4000

# Connexion PostgreSQL : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
DATABASE_URL=postgresql://smartdelivery:CHANGER_MOI@localhost:5432/smartdelivery

# Secret de signature des jetons (64 caractères aléatoires). Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRATION=8h

# Adresse du frontend (CORS + liens de réinitialisation)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Premier administrateur (npm run db:admin), à retirer après création
ADMIN_NOM=
ADMIN_PRENOM=
ADMIN_EMAIL=
ADMIN_TELEPHONE=
ADMIN_MOT_DE_PASSE=

# Dossier des rapports PDF générés (relatif au dossier backend/)
RAPPORTS_DIR=rapports

# ── Assistant IA ─────────────────────────────────────────────────────
# Fournisseur principal : groq (rapide, gratuit) | gemini | openai | anthropic | aucun (mode secours seul)
IA_FOURNISSEUR=groq
# Modèle : openai/gpt-oss-120b (Groq) ; liste : https://console.groq.com/docs/models
IA_MODELE=openai/gpt-oss-120b
# Clé API du fournisseur principal (Groq : https://console.groq.com/keys) — NE JAMAIS la committer
IA_CLE_API=

# Fournisseur de relais (facultatif) : utilisé si le principal est surchargé ou ne répond pas
IA_RELAIS_FOURNISSEUR=gemini
IA_RELAIS_MODELE=gemini-3.5-flash-lite
# Clé Gemini : https://aistudio.google.com/apikey
IA_RELAIS_CLE_API=

# Délai maximal d'un appel (ms) avant de passer au relais puis au mode secours
IA_DELAI_MS=30000
# Facultatif (Gemini 3) : niveau de réflexion minimal | low | medium | high (low = réponses plus rapides)
IA_REFLEXION=low

# ── Données de démonstration (npm run db:seed) ───────────────────────
# Mot de passe des 3 comptes de démo (8 caractères min., lettre + chiffre).
# Laisser vide : un mot de passe est généré et affiché une seule fois.
DEMO_MOT_DE_PASSE=

# ── Hébergement (Render, etc.) ───────────────────────────────────────
# Nombre de proxys devant l'API (1 par défaut en production, 0 en local)
# TRUST_PROXY=1
