{
  "name": "smartdelivery-backend",
  "version": "0.2.0",
  "description": "API SmartDelivery Sénégal (Node.js / Express / PostgreSQL)",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "dev:auto": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:db": "node scripts/test-db.js",
    "db:init": "node scripts/db-init.js",
    "db:reset": "node scripts/db-init.js --reset",
    "db:admin": "node scripts/create-admin.js",
    "db:seed": "node scripts/seed-demo.js",
    "ia:test": "node scripts/test-ia.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pdf-parse": "^1.1.1",
    "supertest": "^7.3.0"
  },
  "main": "src/server.js",
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "testTimeout": 20000
  }
}
